CREATE TABLE movie (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT,
    originalTitle TEXT,
    releaseDate TEXT,
    originalLanguage TEXT,
    overview TEXT,
    source TEXT NOT NULL,
    backdropPath TEXT,
    posterPath TEXT,
    popularity REAL NOT NULL,
    voteAverage REAL NOT NULL,
    voteCount REAL NOT NULL,
    isAdult INTEGER NOT NULL,
    isFavorite INTEGER NOT NULL
);

observeFavorites:
SELECT * FROM movie WHERE isFavorite = 1;

selectById:
SELECT * FROM movie WHERE id = :id;

insertIfAbsent:
INSERT OR IGNORE INTO movie (
    id,
    title,
    originalTitle,
    releaseDate,
    originalLanguage,
    overview,
    source,
    backdropPath,
    posterPath,
    popularity,
    voteAverage,
    voteCount,
    isAdult,
    isFavorite
)
VALUES (
    :id,
    :title,
    :originalTitle,
    :releaseDate,
    :originalLanguage,
    :overview,
    :source,
    :backdropPath,
    :posterPath,
    :popularity,
    :voteAverage,
    :voteCount,
    :isAdult,
    :isFavorite
);

insertOrReplace:
INSERT OR REPLACE INTO movie (
    id,
    title,
    originalTitle,
    releaseDate,
    originalLanguage,
    overview,
    source,
    backdropPath,
    posterPath,
    popularity,
    voteAverage,
    voteCount,
    isAdult,
    isFavorite
)
VALUES (
    :id,
    :title,
    :originalTitle,
    :releaseDate,
    :originalLanguage,
    :overview,
    :source,
    :backdropPath,
    :posterPath,
    :popularity,
    :voteAverage,
    :voteCount,
    :isAdult,
    :isFavorite
);

updateFavorite:
UPDATE movie SET isFavorite = :isFavorite WHERE id = :id;
